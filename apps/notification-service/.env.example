DATABASE_URL="postgresql://outbox:outbox@localhost:5432/notifications_db"
RABBITMQ_URL="amqp://outbox:outbox@localhost:5672"
PORT=3002

# Consumer (Stage 4). All optional; these are the defaults.
CONSUMER_PREFETCH=10
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_MS=5000
# For experiments: make a share of messages fail after the DB writes (0..1)
CONSUMER_SIMULATED_FAILURE_RATE=0
