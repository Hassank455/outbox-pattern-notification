DATABASE_URL="postgresql://outbox:outbox@localhost:5432/notifications_db"
RABBITMQ_URL="amqp://outbox:outbox@localhost:5672"
PORT=3002

# Consumer (Stage 4). All optional; these are the defaults.
CONSUMER_PREFETCH=10
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_MS=5000
# For experiments: make a share of messages fail after the DB writes (0..1)
CONSUMER_SIMULATED_FAILURE_RATE=0

# Email outbox worker (Stage 7). All optional; these are the defaults.
EMAIL_WORKER_ENABLED=true
EMAIL_PROVIDER_URL=http://localhost:3003
EMAIL_WORKER_INTERVAL_MS=1000
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_MAX_ATTEMPTS=8
# Experiments only: send without the Idempotency-Key header / SIGKILL after N sends (0 = off)
EMAIL_USE_IDEMPOTENCY_KEY=true
EMAIL_WORKER_CRASH_AFTER_SENDS=0
