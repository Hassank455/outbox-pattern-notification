// notification-service owns notifications_db.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum NotificationChannel {
  EMAIL
  SMS
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  orderId   String              @map("order_id") @db.Uuid
  recipient String
  channel   NotificationChannel @default(EMAIL)
  subject   String
  body      String
  sentAt    DateTime            @default(now()) @map("sent_at")

  @@map("notifications")
}

// Stage 4: the inbox. One row per message we have already handled.
// Written in the SAME transaction as the notification, so "handled" and
// "notification stored" can't disagree. A second delivery of the same
// messageId finds the row and is skipped.
model ProcessedMessage {
  messageId           String    @id @map("message_id") // AMQP messageId = orders-service outbox id
  messageType         String    @map("message_type") // e.g. "order.created"
  receivedAt          DateTime  @map("received_at") // when the consumer got the first delivery
  processedAt         DateTime  @default(now()) @map("processed_at") // when that delivery was committed
  duplicateDeliveries Int       @default(0) @map("duplicate_deliveries") // later deliveries we skipped
  lastDuplicateAt     DateTime? @map("last_duplicate_at")

  @@map("processed_messages")
}

// Stage 7: an outbox for EMAILS, inside notification-service.
//
// A real email can't be rolled back, so the consumer doesn't send it. Instead it writes this
// row in the SAME transaction as the inbox row and the notification. A separate worker sends
// PENDING rows to the email provider and marks them SENT. Same idea as orders-service's
// outbox_messages + relay, one hop further down the line.
enum EmailStatus {
  PENDING // waiting to be sent (or waiting for its next retry)
  SENT // the provider accepted it
  FAILED // gave up: permanent provider error or too many attempts
}

model OutboundEmail {
  id                String      @id @default(uuid()) @db.Uuid
  // Sent to the provider as the Idempotency-Key header. Built from the AMQP messageId, so it
  // is created ONCE (with the event) and stays the same on every retry. The unique constraint
  // also means one event can never produce two email rows.
  idempotencyKey    String      @unique @map("idempotency_key")
  orderId           String      @map("order_id") @db.Uuid
  recipient         String
  subject           String
  body              String
  status            EmailStatus @default(PENDING)
  attempts          Int         @default(0)
  lastError         String?     @map("last_error")
  nextAttemptAt     DateTime?   @map("next_attempt_at") // backoff: not before this time
  providerMessageId String?     @map("provider_message_id") // the provider's id for the sent email
  createdAt         DateTime    @default(now()) @map("created_at")
  sentAt            DateTime?   @map("sent_at")

  @@index([status, createdAt])
  @@map("outbound_emails")
}
