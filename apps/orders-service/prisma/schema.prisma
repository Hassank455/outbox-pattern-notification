// orders-service owns orders_db.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  customerEmail String      @map("customer_email")
  product       String
  quantity      Int
  totalCents    Int         @map("total_cents")
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("orders")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// Stage 2: the transactional outbox.
// A row here means "this event happened and still has to reach RabbitMQ".
// It is written in the SAME transaction as the business change (the order),
// so either both exist or neither does.
model OutboxMessage {
  id            String       @id @default(uuid()) @db.Uuid // = event id, sent as the AMQP messageId
  aggregateType String       @map("aggregate_type") // e.g. "Order"
  aggregateId   String       @map("aggregate_id") @db.Uuid // which order this event is about
  eventType     String       @map("event_type") // e.g. "order.created"
  routingKey    String       @map("routing_key") // where the relay will publish it
  payload       Json // the event body, frozen at the moment it happened
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0) // publish attempts so far
  lastError     String?      @map("last_error") // why the last attempt failed
  nextAttemptAt DateTime?    @map("next_attempt_at") // Stage 3: retry not before this time (null = ready now)
  createdAt     DateTime     @default(now()) @map("created_at")
  publishedAt   DateTime?    @map("published_at")

  // the relay's query: "oldest PENDING rows first"
  @@index([status, createdAt])
  // the relay skips rows still waiting for their retry time
  @@index([status, nextAttemptAt])
  @@map("outbox_messages")
}
