DATABASE_URL="postgresql://outbox:outbox@localhost:5432/orders_db"
RABBITMQ_URL="amqp://outbox:outbox@localhost:5672"
PORT=3001

# Outbox relay (Stage 3). All optional; these are the defaults.
RELAY_ENABLED=true
RELAY_INTERVAL_MS=1000
RELAY_BATCH_SIZE=50
RELAY_MAX_ATTEMPTS=10
# For experiments: make a share of publishes fail on purpose (0..1)
RELAY_SIMULATED_FAILURE_RATE=0
# Print every SQL statement (BEGIN / COMMIT / ROLLBACK included)
PRISMA_LOG_QUERIES=false
